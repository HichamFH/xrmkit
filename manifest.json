{
  "manifest_version": 3,
  "name": "Xrmkit pour Dynamics 365",
  "short_name": "Xrmkit",
  "version": "0.8.2",
  "description": "Par HichamFH. Boîte à outils pour les applications Dynamics 365 pilotées par modèle : God Mode, FetchXML/OData, analyse d'impact, plug-ins, audit, sécurité, dictionnaire de données, comparaison d'environnements, assistant IA.",
  "minimum_chrome_version": "111",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Xrmkit",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "permissions": [
    "storage",
    "clipboardWrite",
    "activeTab"
  ],
  "host_permissions": [
    "https://*.dynamics.com/*",
    "https://*.microsoftdynamics.us/*",
    "https://*.appsplatform.us/*",
    "https://*.dynamics.cn/*",
    "https://api.anthropic.com/*",
    "https://api.openai.com/*",
    "https://api.cloudflare.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://*.dynamics.com/*",
        "https://*.microsoftdynamics.us/*",
        "https://*.appsplatform.us/*",
        "https://*.dynamics.cn/*"
      ],
      "js": [
        "src/injected.js"
      ],
      "run_at": "document_idle",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://*.dynamics.com/*",
        "https://*.microsoftdynamics.us/*",
        "https://*.appsplatform.us/*",
        "https://*.dynamics.cn/*"
      ],
      "js": [
        "src/content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; base-uri 'none'; frame-ancestors 'none'"
  }
}